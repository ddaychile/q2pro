#!/bin/bash
#
# Q2Dday.app launcher. Sets the working directory to the folder that
# contains Q2Dday.app so game data (baseq2/, ...) resolves next to the bundle,
# then starts the real binary with the game library found in the bundle.
set -e

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"        # Q2Dday.app/Contents/MacOS
APP_PARENT="$(cd "$SELF_DIR/../../.." && pwd)"   # folder containing Q2Dday.app

cd "$APP_PARENT"
exec "$SELF_DIR/q2pro" +set libdir "$SELF_DIR" "$@"
